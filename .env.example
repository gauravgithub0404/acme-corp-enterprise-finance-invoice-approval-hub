# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Render API Key for direct deployment to Render.com
# If not provided, Floe provisions a real backend container/testbed sandbox.
RENDER_API_KEY=""

# Optional: Database connection URL for PostgreSQL persistence
DATABASE_URL=""

# Recommended: secret used to sign Floe Studio session tokens (see
# server.ts requireStudioSession). Required for governance decisions and
# real infrastructure provisioning to keep working across server restarts.
# In production mode (NODE_ENV=production), this variable is strictly required.
# Generate with e.g. `openssl rand -hex 32`. If unset in development, an ephemeral secret
# is generated at boot and all sessions are invalidated on every restart.
SESSION_SECRET=""

# Default Git Repository URL for Render Web Service deployment source control.
#
# HOW STANDALONE DEPLOYMENT WORKS
# --------------------------------
# Floe does not deploy the *generated* app code directly to Render — it deploys
# this repository itself. When the server starts on a Render subdomain it reads
# FLOE_APP_DOMAIN / FLOE_APP_NAME environment variables (or the deployed_app_ir.json
# file) and switches the SPA into standalone-app mode for that domain.
#
# This means every "deployed app" is actually a configured instance of the Floe
# platform running in standalone mode.  To deploy a truly isolated generated app
# you would push the generated source artifacts (from the pipeline) to a separate
# repo and point Render at that repo instead.
#
# Set this to your own fork of this repository.
# If unset, RenderTestProvider will refuse to create a real Render service.
DEFAULT_GIT_REPO_URL=""

# Optional: Ollama API Key & Endpoint (e.g. for Ollama Cloud gpt-oss:120b-cloud or local inference)
# Configurable dynamically by workspace admins in Floe Studio AI Settings
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://cloud.ollama.ai/v1"

# Optional: OpenAI API Key (for GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=""

# Optional: Anthropic API Key (for Claude 3.7 Sonnet, Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=""
